// modal helpers
function openModal(title, html){
  modalTitle.innerText = title;
  modalBody.innerHTML = html;
  modal.classList.add('show');
  modal.style.display = 'flex';
}
function closeModal(){
  modal.classList.remove('show');
  modal.style.display = 'none';
}
document.getElementById('modalClose').addEventListener('click', closeModal);

// small toast
function toast(msg){
  const el = document.createElement('div');
  el.className = 'fixed bottom-6 right-6 bg-black text-white px-4 py-2 rounded';
  el.innerText = msg;
  document.body.appendChild(el);
  setTimeout(()=> el.remove(), 2500);
}

// API wrapper
async function apiFetch(route, opts = {}){
  const url = `${C.api_base}?route=${route}`;
  opts.headers = opts.headers || {};
  opts.headers['X-API-Key'] = C.api_key;
  if(opts.body && typeof opts.body === 'object') {
    opts.headers['Content-Type'] = 'application/json';
    opts.body = JSON.stringify(opts.body);
  }
  const res = await fetch(url, opts);
  if(res.status === 401) { toast('Unauthorized - cek API key'); throw new Error('Unauthorized'); }
  return res.json();
}

// show/hide pages
function showPage(name){
  pages.forEach(p=> p.classList.add('hidden'));
  const el = document.getElementById('page-'+name);
  if(el) el.classList.remove('hidden');
  // load content depending page
  if(name === 'dashboard') loadDashboard();
  if(name === 'bahanBaku') loadBahanBaku();
  if(name === 'bahanJadi') loadBahanJadi();
  if(name === 'produksi') loadProduksi();
  if(name === 'penjualan') loadPenjualan();
  if(name === 'laporan') loadLaporan();
}

