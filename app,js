// PRODUKSI create / list
document.getElementById('btnNewProduksi').addEventListener('click', async ()=>{
  // build produksi form dynamically: select produk & bahan with qty
  const prods = await apiFetch('bahan_jadi/list', {method:'GET'});
  const bahan = await apiFetch('bahan_baku/list', {method:'GET'});
  let prodOptions = prods.map(p=> `<option value="${p.id}">${p.nama} (stok:${p.stok})</option>`).join('');
  let materialInputs = bahan.map(b=>{
    return `<div class="mt-2"><label>${b.nama} (${b.satuan})</label><input data-id="${b.id}" type="number" step="0.001" class="w-full border rounded px-2 py-1" value="0"></div>`;
  }).join('');
  const html = `
    <div>
      <label class="block text-sm">Pilih Produk (Bahan Jadi)</label>
      <select id="prod_produk" class="w-full border rounded px-2 py-1">${prodOptions}</select>
      <label class="block text-sm mt-2">Jumlah Produksi</label>
      <input id="prod_jumlah" type="number" step="0.001" class="w-full border rounded px-2 py-1" value="1">
      <h4 class="mt-3">Material Pemakaian</h4>
      <div id="prod_materials">${materialInputs}</div>
      <div class="mt-3 flex gap-2">
        <button id="prod_save" class="bg-sky-600 text-white px-3 py-1 rounded">Proses</button>
        <button id="prod_cancel" class="px-3 py-1 border rounded">Batal</button>
      </div>
    </div>
  `;
  openModal('Buat Produksi', html);
  document.getElementById('prod_cancel').onclick = closeModal;
  document.getElementById('prod_save').onclick = async ()=>{
    const produk_id = parseInt(document.getElementById('prod_produk').value);
    const jumlah_produksi = parseFloat(document.getElementById('prod_jumlah').value || 0);
    const detail = Array.from(document.querySelectorAll('#prod_materials input[data-id]')).map(i=>({
      bahan_baku_id: parseInt(i.dataset.id), jumlah_pakai: parseFloat(i.value || 0)
    })).filter(x=> x.jumlah_pakai > 0);
    if(!produk_id || !jumlah_produksi || detail.length==0) { toast('Lengkapi form produksi'); return; }
    await apiFetch('produksi/create', {method:'POST', body: {produk_id, jumlah_produksi, detail}});
    toast('Produksi berhasil'); closeModal(); loadProduksi(); loadBahanBaku(); loadBahanJadi();
  };
});

