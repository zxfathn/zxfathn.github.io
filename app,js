// app.js - module
const DEFAULT_API_BASE = "http://backendblueharvest.wuaze.com/api.php";
const DEFAULT_API_KEY = "BH-40662036_STATIC";

const C = {
  api_base: localStorage.getItem('bh_api_base') || DEFAULT_API_BASE,
  api_key: localStorage.getItem('bh_api_key') || DEFAULT_API_KEY,
  logged: false
};

// DOM
