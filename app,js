        <button id="login_cancel" class="px-3 py-1 border rounded">Batal</button>
      </div>
    </div>
  `);
  document.getElementById('login_cancel').onclick = closeModal;
  document.getElementById('login_save').onclick = ()=>{
    const k = document.getElementById('login_key').value.trim();
    if(!k) return toast('Masukkan API key');
    C.api_key = k; localStorage.setItem('bh_api_key', k);
    C.logged = true; document.getElementById('btnLogout').classList.remove('hidden'); document.getElementById('btnLogin').classList.add('hidden');
    closeModal(); toast('API key disimpan');
  };
}

