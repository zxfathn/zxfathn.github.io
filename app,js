// DASHBOARD
async function loadDashboard(){
  try{
    const data = await apiFetch('laporan/stok', {method:'GET'});
    document.getElementById('dash-bb').innerText = data.bahan_baku.length || 0;
    document.getElementById('dash-bj').innerText = data.bahan_jadi.length || 0;
    // quick production count (best-effort)
    const p = await apiFetch('produksi/list', {method:'GET'}).catch(()=>[]);
    document.getElementById('dash-prod').innerText = (p && p.length) || 0;
  }catch(err){
    console.error(err); toast('Gagal load dashboard');
  }
}

// BAHAN BAKU CRUD
document.getElementById('btnAddBahanBaku').addEventListener('click', ()=> {
  openModal('Tambah Bahan Baku', formBahanBaku());
  initBahanBakuForm();
});
document.getElementById('btnReloadBB').addEventListener('click', loadBahanBaku);

async function loadBahanBaku(){
  try{
    const rows = await apiFetch('bahan_baku/list', {method:'GET'});
    const tbody = document.querySelector('#tblBahanBaku tbody');
    tbody.innerHTML = '';
    for(const r of rows){
      const tr = document.createElement('tr');
      tr.innerHTML = `<td class="p-2">${r.id}</td>
        <td class="p-2">${r.nama}</td>
        <td class="p-2">${r.stok}</td>
        <td class="p-2">${r.satuan}</td>
        <td class="p-2">
          <button class="editBB mr-2 text-sm px-2 py-1 border rounded" data-id="${r.id}">Edit</button>
          <button class="delBB text-sm px-2 py-1 border rounded" data-id="${r.id}">Hapus</button>
        </td>`;
      tbody.appendChild(tr);
    }
    // bind actions
    document.querySelectorAll('.editBB').forEach(btn=> btn.addEventListener('click', async e=>{
      const id = e.target.dataset.id;
      const row = rows.find(x=> x.id == id);
      openModal('Edit Bahan Baku', formBahanBaku(row));
      initBahanBakuForm(id);
    }));
    document.querySelectorAll('.delBB').forEach(btn=> btn.addEventListener('click', async e=>{
      if(!confirm('Hapus bahan baku?')) return;
      const id = e.target.dataset.id;
      await apiFetch(`bahan_baku/${id}`, {method:'DELETE'});
      toast('Dihapus'); loadBahanBaku();
    }));
  }catch(err){ console.error(err); toast('Gagal load bahan baku'); }
}

function formBahanBaku(data = {}){
  return `
    <div>
      <label class="block text-sm">Nama</label>
      <input id="fb_nama" class="w-full border rounded px-2 py-1" value="${data.nama || ''}">
      <label class="block text-sm mt-2">Satuan</label>
      <input id="fb_satuan" class="w-full border rounded px-2 py-1" value="${data.satuan || 'pcs'}">
      <label class="block text-sm mt-2">Stok</label>
      <input id="fb_stok" type="number" step="0.001" class="w-full border rounded px-2 py-1" value="${data.stok || 0}">
      <div class="mt-3 flex gap-2">
        <button id="fb_save" class="bg-green-600 text-white px-3 py-1 rounded">Simpan</button>
        <button id="fb_cancel" class="px-3 py-1 border rounded">Batal</button>
      </div>
    </div>
  `;
}

function initBahanBakuForm(editId){
  document.getElementById('fb_cancel').onclick = closeModal;
  document.getElementById('fb_save').onclick = async ()=>{
    const payload = {
      nama: document.getElementById('fb_nama').value.trim(),
      satuan: document.getElementById('fb_satuan').value.trim(),
      stok: parseFloat(document.getElementById('fb_stok').value || 0)
    };
    if(editId){
      await apiFetch(`bahan_baku/${editId}`, {method:'PUT', body: payload});
      toast('Diupdate');
    } else {
      await apiFetch('bahan_baku/add', {method:'POST', body: payload});
      toast('Ditambahkan');
    }
    closeModal(); loadBahanBaku();
  };
}

