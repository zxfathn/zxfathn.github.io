// LOGIN (simple: just modal, no backend auth for now)
function showLogin(){
  openModal('Login (opsional)', `
    <div>
      <label class="block text-sm">API Key</label>
      <input id="login_key" class="w-full border rounded px-2 py-1" value="${C.api_key}">
      <div class="mt-3 flex gap-2">
